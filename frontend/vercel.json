{
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "https://nutrex-api-gateway.onrender.com/api/chat"
    },
    {
      "source": "/api/chat/",
      "destination": "https://nutrex-api-gateway.onrender.com/api/chat/"
    },
    {
      "source": "/api/ai/:path*",
      "destination": "https://nutrex-ai-service.onrender.com/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://nutrex-api-gateway.onrender.com/api/:path*"
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
